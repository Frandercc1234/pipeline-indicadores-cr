# Valores de ejemplo. Los reales van en etl/.env, api/.env y en los secrets de GitHub.
# Postgres local (docker compose): 127.0.0.1:5433 (no uses localhost: en Windows tarda 8 s por IPv6), base indicadores, dueño indicadores_owner.
BCCR_TOKEN=pegar-aqui-en-etl/.env
BCCR_BASE_URL=https://apim.bccr.fi.cr/SDDE/api/Bccr.GE.SDDE.Publico.Indicadores.API
BCCR_MODO=simulado
DATABASE_URL_ADMIN=postgresql://neondb_owner:***@ep-xxx.neon.tech/indicadores?sslmode=require
DATABASE_URL_ETL=postgresql://etl_writer:***@ep-xxx.neon.tech/indicadores?sslmode=require
DATABASE_URL_API=postgresql://api_reader:***@ep-xxx.neon.tech/indicadores?sslmode=require
POSTGRES_PASSWORD=generar-una-contrasena-larga
ETL_DB_PASSWORD=generar-una-contrasena-larga
API_DB_PASSWORD=generar-una-contrasena-larga
PORT=3001
CORS_ORIGENES=http://localhost:3000,https://indicadores-cr.vercel.app
THROTTLE_LIMIT=60
THROTTLE_TTL_MS=60000
RENDER_GIT_COMMIT=a1b2c3
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=https://indicadores-cr-api.onrender.com
VERCEL_GIT_COMMIT_SHA=a1b2c3
URL_API=http://localhost:3001
URL_WEB=http://localhost:3000
GITHUB_TOKEN=lo-da-github-automaticamente
